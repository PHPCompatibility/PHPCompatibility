<?xml version="1.0"?>
<documentation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://phpcsstandards.github.io/PHPCSDevTools/phpcsdocs.xsd"
    title="New Array Unpacking"
    >
    <standard>
    <![CDATA[
    Since PHP 7.4, the spread operator can be used to unpack arrays within array declarations.
    ]]>
    </standard>
    <code_comparison>
        <code title="Cross-version compatible: using array_merge().">
        <![CDATA[
$a = [2, 3];

$b = array_merge([0, 1], $a, [4, 5]);
        ]]>
        </code>
        <code title="PHP &gt;= 7.4: array unpacking with spread operator.">
        <![CDATA[
$a = [2, 3];

$b = [0, 1, <em>...</em>$a, 4, 5];
        ]]>
        </code>
    </code_comparison>
</documentation>
